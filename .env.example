# Select `mock` for offline demo data or `tidal` for the official TIDAL catalog.
VITE_MUSIC_SOURCE=mock

# Public app configuration only. Never add a client secret or token here.
VITE_TIDAL_CLIENT_ID=
# A registered HTTPS URI; the callback page must hand off to
# chromatic-player://oauth/callback?code=...&state=...
VITE_TIDAL_REDIRECT_URI=
# Comma-separated scopes approved for this TIDAL application. Empty uses no extra scopes.
VITE_TIDAL_SCOPES=
